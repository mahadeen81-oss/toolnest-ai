# Server-side only. Never expose this in client code or prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model used by the API route.
# Check https://ai.google.dev for current available model names before deploying.
GEMINI_MODEL=gemini-2.5-flash

# Add your GA4 Measurement ID from Google Analytics (format: G-XXXXXXXXXX).
# In Replit, add this variable under Secrets/Environment Variables before deploying.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
